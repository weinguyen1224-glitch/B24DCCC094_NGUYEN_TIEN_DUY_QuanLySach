<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView style="@style/FormScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/cover_height">

                <LinearLayout
                    android:id="@+id/cover"
                    android:layout_width="@dimen/cover_width"
                    android:layout_height="@dimen/cover_height"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cover_padding">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="4"
                        android:textColor="#FFF7E6"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#66FFF7E6" />

                    <TextView
                        android:id="@+id/tvCoverAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#DDFFF7E6"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvAuthorGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                style="@style/Label"
                android:text="@string/add_status" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Label"
                android:text="@string/add_rating" />

            <RatingBar
                android:id="@+id/ratingBar"
                style="@style/Rating" />

            <TextView
                style="@style/Label"
                android:text="@string/add_note" />

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:minHeight="72dp"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnMarkRead"
                style="@style/PrimaryButton"
                android:layout_marginTop="26dp"
                android:text="@string/detail_mark_read" />

            <Button
                android:id="@+id/btnDelete"
                style="@style/DangerButton"
                android:layout_marginTop="12dp"
                android:text="@string/detail_delete" />

            <Button
                android:id="@+id/btnBack"
                style="@style/SecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/detail_back" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
