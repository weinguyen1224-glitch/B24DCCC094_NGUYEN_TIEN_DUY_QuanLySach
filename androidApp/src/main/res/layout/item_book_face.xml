<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="@dimen/shelf_height"
    android:layout_weight="1"
    android:clipChildren="false"
    android:gravity="bottom"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/open_book_lift">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_open_book_pages" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/open_book_pages"
            android:layout_marginEnd="@dimen/open_book_pages"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cover"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="2"
                    android:textColor="#FFF7E6"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Lập trình Android cơ bản" />

                <TextView
                    android:id="@+id/tvAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#DDFFF7E6"
                    android:textSize="10sp"
                    tools:text="Nguyễn Văn A" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#CCFFF7E6"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="Đang đọc" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_rating_dark"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="1dp"
                    android:textColor="#F2D9A0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="4/5" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
