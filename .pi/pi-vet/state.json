      "originalContent": "package com.library.bookmanager.ui;\n\nimport android.content.Context;\nimport android.graphics.Canvas;\nimport android.graphics.LinearGradient;\nimport android.graphics.Paint;\nimport android.graphics.RectF;\nimport android.graphics.Shader;\nimport android.util.AttributeSet;\nimport android.view.View;\n\nimport com.library.bookmanager.data.Book;\n\npublic class BookView extends View {\n\n    private static final int[] PALETTE = {\n            0xFF7B4B2A, 0xFF2F5D62, 0xFF8C2F39, 0xFF3E5C2F, 0xFF4B3F72, 0xFFB08968,\n    };\n\n    private static final int SHADOW = 0xFF1B1005;\n    private static final int BAND = 0xFFFFF3DC;\n    private static final int BAND_SHADE = 0xFFE3D2B2;\n    private static final int EDGE = 0x33FFFFFF;\n\n    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);\n    private final RectF body = new RectF();\n\n    private int accent = PALETTE[0];\n    private boolean pressed;\n\n    public BookView(Context context, AttributeSet attrs) {\n        super(context, attrs);\n        setClickable(true);\n        setFocusable(true);\n    }\n\n    public void bind(Book book) {\n        accent = PALETTE[Math.floorMod(book.getTitle().hashCode(), PALETTE.length)];\n        invalidate();\n    }\n\n    @Override\n    public void setPressed(boolean pressed) {\n        super.setPressed(pressed);\n        this.pressed = pressed;\n        invalidate();\n    }\n\n    @Override\n    protected void onDraw(Canvas canvas) {\n        float w = getWidth();\n        float h = getHeight();\n        float radius = 3f * getResources().getDisplayMetrics().density;\n        float bandTop = h * 0.28f;\n        float bandBottom = h * 0.72f;\n        float bandThickness = bandBottom - bandTop;\n\n        body.set(0f, 0f, w, h);\n        paint.setShader(null);\n        paint.setColor(SHADOW);\n        canvas.drawRoundRect(body, radius, radius, paint);\n\n        body.set(0f, 0f, w, h - radius);\n        paint.setShader(new LinearGradient(0f, 0f, w, 0f, accent, SHADOW, Shader.TileMode.CLAMP));\n        canvas.drawRoundRect(body, radius, radius, paint);\n\n        body.set(0f, bandTop, w, bandBottom);\n        paint.setShader(new LinearGradient(0f, bandTop, 0f, bandBottom, BAND, BAND_SHADE, Shader.TileMode.CLAMP));\n        canvas.drawRect(body, paint);\n\n        paint.setShader(null);\n        paint.setColor(accent);\n        paint.setAlpha(80);\n        canvas.drawRect(0f, bandTop + bandThickness * 0.16f, w, bandTop + bandThickness * 0.21f, paint);\n        canvas.drawRect(0f, bandBottom - bandThickness * 0.21f, w, bandBottom - bandThickness * 0.16f, paint);\n\n        paint.setColor(EDGE);\n        paint.setAlpha(48);\n        canvas.drawRect(0f, 0f, 1.5f * getResources().getDisplayMetrics().density, h - radius, paint);\n\n        if (pressed) {\n            body.set(0f, 0f, w, h);\n            paint.setColor(0x33000000);\n            paint.setAlpha(0x33);\n            canvas.drawRoundRect(body, radius, radius, paint);\n        }\n    }\n}\n",
